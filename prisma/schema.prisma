generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id             String   @id
  displayName    String
  dateOfBirth    String
  sex            String
  syntheticLabel String   @default("SYNTHETIC_ONLY")
  fhirBundleJson String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentIdentity {
  id              String   @id
  displayName     String
  kind            String
  publicKeyPem    String
  privateKeyPem   String?
  valironAgentId  String?
  walletAddress   String?
  defaultTier     String
  defaultRoute    String
  onChainScore    Int
  behaviorScore   Int
  identityScore   Int
  complianceScore Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Delegation {
  id                String   @id
  patientId         String
  agentId           String
  scopesJson        String
  purpose           String
  expiresAt         DateTime
  status            String
  canonicalPayload  String
  delegationHash    String
  patientSignature  String
  solanaSignature   String?
  solanaExplorerUrl String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
  @@index([agentId])
  @@index([delegationHash])
}

model AuditEvent {
  id                 String   @id
  requestId          String
  agentId            String?
  patientId          String?
  method             String
  path               String
  decision           String
  route              String
  trustTier          String
  trustScore         Int
  reason             String
  requiredScopesJson String
  grantedScopesJson  String?
  httpStatus         Int
  latencyMs          Int
  costMicros         Int
  delegationHash     String?
  requestHash        String
  responseHash       String?
  modelUsed          String?
  toolCallsJson      String?
  sandboxRunId       String?
  sandboxRiskScore   Int?
  sandboxVerdict     String?
  createdAt          DateTime @default(now())

  @@index([agentId])
  @@index([patientId])
  @@index([requestId])
  @@index([createdAt])
}

model Nonce {
  agentId   String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([agentId, nonce])
  @@index([expiresAt])
}

model SandboxRun {
  id                 String   @id
  agentId            String
  scenario           String
  mode               String
  runtime            String
  riskScore          Int
  verdict            String
  routeImpact        String
  observedEventsJson String
  signalsJson        String
  stdoutJson         String
  stderrJson         String
  durationMs         Int
  error              String?
  createdAt          DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}
