generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PriorAuthCase {
  id                   String   @id
  patientId            String
  patientName          String
  memberId             String
  providerNpi          String
  providerName         String
  payerId              String
  payerName            String
  serviceCode          String
  serviceDisplay       String
  diagnosisCodesJson   String
  status               String   @default("ready_for_demo")
  syntheticOnly        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PriorAuthRun {
  id            String   @id
  caseId        String
  scenario      String
  status        String
  eventCount    Int      @default(0)
  roiJson       String?
  evidenceJson  String?
  submissionJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([caseId])
  @@index([createdAt])
}

model PriorAuthAuditEvent {
  id           String   @id
  runId        String
  caseId       String
  status       String
  evidenceHash String
  roiHash      String
  syntheticOnly Boolean @default(true)
  createdAt    DateTime @default(now())

  @@index([runId])
  @@index([caseId])
  @@index([createdAt])
}
