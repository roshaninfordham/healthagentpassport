{
  "name": "priorauth-passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "studio": "next dev -p 3000",
    "ehr": "pnpm --filter sample-ehr-api dev",
    "payer": "pnpm --filter sample-payer-api dev",
    "demo": "concurrently -n EHR,PAYER,STUDIO,READY -c cyan,yellow,magenta,green \"pnpm ehr\" \"pnpm payer\" \"pnpm studio\" \"node scripts/demo-ready.mjs\"",
    "doctor": "pnpm --filter @priorauth/passport-cli dev doctor",
    "priorauth": "pnpm --filter @priorauth/passport-cli dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src tests prisma --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit && pnpm --filter @priorauth/passport-core typecheck && pnpm --filter @priorauth/passport-cli typecheck && pnpm --filter sample-ehr-api typecheck && pnpm --filter sample-payer-api typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "pnpm db:reset && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "docs:diagrams": "node scripts/extract-mermaid.mjs README.md docs/*.md",
    "docs:diagrams:render": "pnpm docs:diagrams && node scripts/render-mermaid.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm --filter @priorauth/passport-core build && pnpm --filter @priorauth/passport-cli build && pnpm --filter sample-ehr-api build && pnpm --filter sample-payer-api build"
  },
  "dependencies": {
    "@priorauth/passport-core": "workspace:*",
    "@prisma/client": "^6.10.1",
    "commander": "^14.0.2",
    "concurrently": "^9.2.1",
    "fastify": "^5.6.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.3",
    "sonner": "^1.7.4",
    "yaml": "^2.8.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.10.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
