{
  "name": "healthagent-passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "studio": "next dev -p 3000",
    "sample-api": "pnpm --filter sample-health-api dev",
    "gateway": "pnpm --filter @healthagent/passport-cli dev gateway --policy ./healthagent.yaml --upstream http://localhost:4001 --port 8787 --studio http://localhost:3000 --demo-delay 650",
    "demo": "concurrently -n API,GATEWAY,STUDIO -c blue,green,magenta \"pnpm sample-api\" \"pnpm gateway\" \"pnpm studio\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src tests prisma --max-warnings=0",
    "typecheck": "tsc --noEmit && pnpm --filter @healthagent/passport typecheck && pnpm --filter @healthagent/passport-cli typecheck && pnpm --filter sample-health-api typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "pnpm db:reset && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm --filter @healthagent/passport build && pnpm --filter @healthagent/passport-cli build && pnpm --filter sample-health-api build"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.2",
    "concurrently": "^9.2.1",
    "fastify": "^5.6.2",
    "framer-motion": "^11.18.2",
    "json-stable-stringify": "^1.3.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "^11.11.4",
    "recharts": "^2.15.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.10.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
